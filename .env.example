PORT=8080
DATABASE_URL=postgres://usuario:password@localhost:5432/maceli_db?sslmode=disable
FRONTEND_URL=http://localhost:5173
# Bootstrap creates the first administrator only; remove these after first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Password must be unique and at least 12 characters (maximum 72 UTF-8 bytes).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PATH=maceli/site
# Render sets RENDER=true. For other production hosts use APP_ENV=production.
APP_ENV=development
# Only confirmed proxy IP/CIDR ranges, never 0.0.0.0/0. Empty trusts no forwarded headers.
TRUSTED_PROXIES=
